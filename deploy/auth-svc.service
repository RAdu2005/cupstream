[Unit]
Description=Cup stream auth-svc
After=network.target mediamtx.service
Wants=mediamtx.service

[Service]
Type=simple
User=auth-svc
Group=auth-svc
EnvironmentFile=/etc/auth-svc/env
ExecStartPre=/bin/sh -c 'test -f /etc/auth-svc/env || { echo "Missing /etc/auth-svc/env"; exit 1; }'
ExecStart=/usr/local/bin/auth-svc
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/auth-svc
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

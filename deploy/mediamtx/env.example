# /etc/mediamtx/env for mediamtx.service (root:mediamtx 640).

# Advertise only the public interface in ICE candidates, not VPN or other
# private addresses. Set MTX_WEBRTCADDITIONALHOSTS instead when the public IP
# is not on an interface (behind NAT).
MTX_WEBRTCIPSFROMINTERFACESLIST=enp6s0

# Collect garbage less often: MediaMTX allocates for every packet, and the
# server has memory to spare (see compose.yaml).
GOGC=800
GOMEMLIMIT=16GiB

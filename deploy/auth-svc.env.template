# ============================================
# auth-svc environment configuration
# Copy this file to /etc/auth-svc/env (native)
# or .env (docker) and fill in the values.
# ============================================

# Public domain of the web app (Cloudflare-proxied).
# Used for autocert TLS certificate validation.
DOMAIN=example.com

# Bcrypt hash of the admin login password.
# Generate with: ./auth-svc hash <password>
PASSWORD_HASH=

# JWT signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=

# MediaMTX API base URL (internal).
MEDIAMTX_API=http://127.0.0.1:9997

# MediaMTX WebRTC/WHEP base URL (internal).
MEDIAMTX_WEBRTC=http://127.0.0.1:8889

# Username for OBS / publisher authentication.
MEDIAMTX_PUBLISH_USER=obs

# Bcrypt hash of the OBS publish password.
# Generate with: ./auth-svc hash <password>
MEDIAMTX_PUBLISH_HASH=

# Localhost listener address for MediaMTX auth callbacks.
MEDIAMTX_AUTH_ADDR=127.0.0.1:9998

# HTTP listen port. Use 443 for production (TLS).
PORT=443

# Enable TLS / autocert. Set to "no" for dev or behind a reverse proxy.
TLS=yes

# Directory to store autocert certificates.
CERT_DIR=/var/lib/auth-svc/certs

# Optional: path to an alternative env file.
# ENV_FILE=

PASSWORD_HASH=$2a$14$zFYnMCWBqq3cbYRpf7z43e/.alegeg5u3DY7bcEC1PCFQe50JQySC
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
MEDIAMTX_API=http://127.0.0.1:9997
MEDIAMTX_WEBRTC=http://127.0.0.1:8889
# bcrypt hash of the OBS publish password; generate with `auth-svc hash <pw>`.
MEDIAMTX_PUBLISH_USER=radu
MEDIAMTX_PUBLISH_HASH=replace-with-bcrypt-hash-of-new-publish-password
# Localhost listener for MediaMTX's authHTTPAddress callback.
MEDIAMTX_AUTH_ADDR=127.0.0.1:9998
PORT=443
TLS=yes
CERT_DIR=/var/lib/auth-svc/certs

# --- MediaMTX side (mediamtx.yml) ---
# Auth is delegated to auth-svc's bcrypt-validated callback — no plaintext
# credentials in this file. Set:
#
#   authMethod: http
#   authHTTPAddress: http://127.0.0.1:9998/
#   authHTTPExclude: [api, metrics, pprof]
#
# WebRTC playback is on the :8889 listener. WHEP signaling is at
# /<path>/whep, e.g. POST /live/whep.
#
#   webrtc: yes
#   webrtcAddress: <public-ip>
#   webrtcEncryption: "no"          # TLS is terminated at auth-svc / CF
#   webrtcAdditionalHosts: [mediamtx.cup.larp.love, cup.larp.love]
#   webrtcICEServers2:
#     - url: stun:stun.l.google.com:19302
#
# DNS:
#   cup.larp.love            -> CF-proxied (page, auth, chat, WHEP signaling)
#   mediamtx.cup.larp.love   -> origin A-record, NOT proxied (RTP/UDP media)
#
# Firewall on origin: open TCP 8889 (signaling) and UDP 8189 (WebRTC media).

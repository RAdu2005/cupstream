# Server configuration (all optional; defaults shown). Copy to .env for
# `docker compose up`. scripts/dev.sh sets its own development values.

# CUPSTREAM_ADDR=:8080
# CUPSTREAM_PUBLIC_URL=http://localhost:8080
# CUPSTREAM_DB=data/cupstream.db
# CUPSTREAM_MEDIAMTX_API=http://127.0.0.1:9997
# CUPSTREAM_MEDIAMTX_WEBRTC=http://127.0.0.1:8889
# CUPSTREAM_LOG_LEVEL=info          # debug, info, warn, error
# CUPSTREAM_LOG_FORMAT=json         # json or text
# CUPSTREAM_TLS_CERT=               # with CUPSTREAM_TLS_KEY: serve HTTPS
# CUPSTREAM_TLS_KEY=

# Header with the client's address, trusted only on connections from this
# machine (a tunnel connector or reverse proxy). Behind a Cloudflare Tunnel:
# CUPSTREAM_CLIENT_IP_HEADER=CF-Connecting-IP

# 32 random bytes, base64 (openssl rand -base64 32). Seals OAuth cookies and
# stored Discord refresh tokens. Required unless the development login is on.
# CUPSTREAM_SECRET_KEY=

# OAuth applications. Redirect URLs: <public URL>/api/auth/google/callback and
# <public URL>/api/auth/discord/callback (in development the public URL is
# http://localhost:5173). A provider is enabled when both values are set.
# CUPSTREAM_GOOGLE_CLIENT_ID=
# CUPSTREAM_GOOGLE_CLIENT_SECRET=
# CUPSTREAM_DISCORD_CLIENT_ID=
# CUPSTREAM_DISCORD_CLIENT_SECRET=

# The Discord bot (same application as Discord sign-in), which enables
# Discord rooms. It needs no privileged intents.
# CUPSTREAM_DISCORD_BOT_TOKEN=

# Admins, by sign-in identity: comma-separated provider:subject, e.g.
# discord:<Discord user ID> or google:<Google account "sub">. Admins see
# /admin (live streams, viewers, bandwidth), can end any stream and ban
# users. Handles are not accepted, since users choose their own. With the
# development login, the identity is dev:<handle>.
# CUPSTREAM_ADMINS=

# Passwordless login for local development and tests. Refused unless
# CUPSTREAM_PUBLIC_URL is localhost, *.localhost or *.test.
# CUPSTREAM_DEV_LOGIN=false

# Per-address rate limits on signing in, going live, opening viewer sessions,
# WebSocket connections and other changes. Turning them off (for load tests
# from one machine) is refused unless CUPSTREAM_PUBLIC_URL is a local host.
# CUPSTREAM_RATE_LIMITS=true

# Admission control: new viewers are refused while the outgoing traffic,
# measured on the network interfaces, would go above this many megabits per
# second (0: never refuse). By default every physical interface is measured
# (not lo, bridges or tunnels); name them, comma-separated, to choose.
# CUPSTREAM_EGRESS_LIMIT_MBPS=800
# CUPSTREAM_EGRESS_INTERFACE=

# Public IP or hostname that MediaMTX advertises in ICE candidates.
# MTX_WEBRTCADDITIONALHOSTS=
